# Copy to .env for local development. NEVER commit .env.

# --- Required ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_API_ID=               # from https://my.telegram.org -> API development tools
TELEGRAM_API_HASH=
AUTHORIZED_USER_ID=            # your numeric Telegram ID (message @userinfobot)
DATABASE_URL=sqlite:///shill_monitor.db   # Render: use the Postgres *Internal* connection string

# --- Account session (choose ONE approach; see README) ---
# A) Generate locally with scripts/generate_session.py and store as a secret:
TELETHON_SESSION=
# B) Link inside the bot (/connect). Set ANY long random string here (Render generates one for you);
#    it encrypts the stored session. Never change it afterwards.
SESSION_ENCRYPTION_KEY=

# --- Optional ---
FORWARD_CHAT=@fergbotalgogc    # group that receives every CA + its source name (change anytime in the bot: 📤 Forward)
LOG_LEVEL=INFO
RETENTION_DAYS=14              # how long processed-message records are kept
MAX_RECONNECT_ATTEMPTS=8       # then stop and ask you to reconnect
RECONNECT_BASE_DELAY=5         # seconds; doubles each attempt (cap 300s)
# PORT is set automatically by Render Web Services. Leave unset for local runs / Background Workers.
